{
  "version": "0.4.1",
  "description": "AI engine proxy for Claude, Codex, Gemini and more.",
  "homepage": "https://github.com/Villoh/tunnel-agent",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Villoh/tunnel-agent/releases/download/v0.4.1/TunnelAgent-0.4.1-win-Setup.exe",
      "hash": "PLACEHOLDER"
    }
  },
  "installer": {
    "script": [
      "& \"$dir\\TunnelAgent-$version-win-Setup.exe\" --silent"
    ]
  },
  "uninstaller": {
    "script": [
      "$installDir = \"$env:LOCALAPPDATA\\TunnelAgent\"",
      "$uninstaller = Get-ChildItem \"$installDir\" -Filter \"Update.exe\" -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
      "if ($uninstaller) { & $uninstaller.FullName --uninstall }"
    ]
  },
  "shortcuts": [
    ["$env:LOCALAPPDATA\\TunnelAgent\\TunnelAgent.exe", "Tunnel Agent"]
  ],
  "checkver": {
    "url": "https://github.com/Villoh/tunnel-agent/releases/latest/download/latest.json",
    "jsonpath": "$.version"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Villoh/tunnel-agent/releases/download/v$version/TunnelAgent-$version-win-Setup.exe",
        "hash": {
          "url": "https://github.com/Villoh/tunnel-agent/releases/latest/download/latest.json",
          "jsonpath": "$.installer.sha256"
        }
      }
    }
  }
}
